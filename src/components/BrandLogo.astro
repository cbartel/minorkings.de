---
interface Props { class?: string; decorative?: boolean; }
const { class: className = '', decorative = false } = Astro.props;
---
<span class:list={['brand-logo', className]}>
  <img src={`${import.meta.env.BASE_URL}brand/minor-kings.png`} width="512" height="512" alt={decorative ? '' : 'minor kings – Red Hot Chili Peppers Tribute'} aria-hidden={decorative ? 'true' : undefined} />
</span>
