---
import Icon from './Icon.astro';
import feed from '../data/instagram.json';
const asset = (name: string) => `${import.meta.env.BASE_URL}media/${name}.webp`;
---
<div id="instagram-posts" class="instagram-grid">{feed.posts.map((post, i) => <article class="instagram-post">
  <a class="instagram-open" href={post.url} data-index={i} aria-label={`${post.alt} – vergrößern`}><img src={asset(post.image)} width="640" height="640" alt={post.alt} loading="lazy" /><span class="post-overlay"><span>{post.label}</span><span aria-hidden="true"><Icon name="plus" /></span></span><span class="post-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span></a>
  <template><p>{post.caption}</p></template>
</article>)}</div>
<button class="button instagram-more" type="button" aria-controls="instagram-posts" hidden>Mehr Fotos anzeigen <Icon name="plus" /></button>
<p class="sr-only instagram-status" role="status"></p>
<div class="instagram-footer"><span>Fotos u. a. von @pluno</span><a class="text-link" href="https://www.instagram.com/minorkings/" target="_blank" rel="noopener noreferrer">Mehr auf Instagram <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>
<dialog class="instagram-dialog" aria-labelledby="post-title">
  <button class="dialog-close" aria-label="Foto schließen" autofocus><Icon name="close" /></button>
  <div class="dialog-layout"><div class="dialog-photo"><img alt="" /><button class="previous" aria-label="Vorheriger Beitrag"><Icon name="arrow-left" /></button><button class="next" aria-label="Nächster Beitrag"><Icon name="arrow-right" /></button></div><div class="dialog-copy"><p class="eyebrow">@minorkings / Instagram</p><h3 id="post-title">Hinter den Kulissen</h3><p class="dialog-caption"></p><a class="button original-post" target="_blank" rel="noopener noreferrer">Auf Instagram öffnen <Icon name="arrow-up-right" /></a><p class="media-note">Reels, weitere Bilder und Kommentare findet ihr im Originalbeitrag.</p><span class="dialog-count" aria-live="polite"></span></div></div>
</dialog>
<script>
 const dialog = document.querySelector<HTMLDialogElement>('.instagram-dialog');
 const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.instagram-open'));
 const grid = document.querySelector<HTMLElement>('.instagram-grid');
 const more = document.querySelector<HTMLButtonElement>('.instagram-more');
 const posts = Array.from(document.querySelectorAll<HTMLElement>('.instagram-post'));
 let visiblePosts = 6;
 function updateVisiblePosts() {
  posts.forEach((post, index) => post.classList.toggle('mobile-pending', index >= visiblePosts));
  if (more) more.hidden = visiblePosts >= posts.length;
 }
 if (grid && more) {
  updateVisiblePosts();
  more.addEventListener('click', () => {
   const firstNew = visiblePosts;
   visiblePosts = Math.min(visiblePosts + 6, posts.length);
   updateVisiblePosts();
   document.querySelector('.instagram-status')!.textContent = `${visiblePosts} von ${posts.length} Fotos sichtbar`;
   links[firstNew]?.focus({ preventScroll: true });
  });
 }
 let current = 0;
 let opener: HTMLAnchorElement | undefined;
 function show(index: number) {
  if (!dialog || !links.length) return;
  current = (index + links.length) % links.length;
  const link = links[current];
  const image = link.querySelector('img')!;
  const target = dialog.querySelector<HTMLImageElement>('img')!;
  target.src = image.src; target.alt = image.alt;
  const caption = link.closest('article')?.querySelector('template')?.content.textContent || '';
  dialog.querySelector('.dialog-caption')!.textContent = caption;
  dialog.querySelector<HTMLAnchorElement>('.original-post')!.href = link.href;
  dialog.querySelector('.dialog-count')!.textContent = `${current+1} / ${links.length}`;
 }
 links.forEach((link, index) => link.addEventListener('click',event => {
  if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
  event.preventDefault(); opener=link; show(index); dialog.showModal(); document.body.classList.add('dialog-is-open');
 }));
 dialog?.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
 dialog?.querySelector('.previous')?.addEventListener('click',()=>show(current-1));
 dialog?.querySelector('.next')?.addEventListener('click',()=>show(current+1));
 dialog?.addEventListener('keydown',event=>{if(event.key==='ArrowLeft')show(current-1);if(event.key==='ArrowRight')show(current+1);});
 dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
 dialog?.addEventListener('close',()=>{document.body.classList.remove('dialog-is-open');opener?.focus();});
</script>

<style>
 .instagram-more { display: none; }
 @media (max-width: 680px) {
  .instagram-post.mobile-pending { display: none; }
  .instagram-more:not([hidden]) { display: flex; width: 100%; margin-top: 1.25rem; }
 }
</style>
