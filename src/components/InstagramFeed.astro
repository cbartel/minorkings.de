---
import feed from '../data/instagram.json';
const asset = (name: string) => `${import.meta.env.BASE_URL}media/${name}.webp`;
---
<div class="instagram-grid">{feed.posts.map((post, i) => <article class="instagram-post">
  <a class="instagram-open" href={post.url} data-index={i} aria-label={`${post.alt} – vergrößern`}><img src={asset(post.image)} width="640" height="640" alt={post.alt} loading="lazy" /><span class="post-overlay"><span>{post.label}</span><span aria-hidden="true">＋</span></span><span class="post-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span></a>
  <template><p>{post.caption}</p></template>
</article>)}</div>
<div class="instagram-footer"><span>Fotos: @pluno</span><a class="text-link" href="https://www.instagram.com/minorkings/" target="_blank" rel="noopener noreferrer">Mehr auf Instagram <span aria-hidden="true">↗</span></a></div>
<dialog class="instagram-dialog" aria-labelledby="post-title">
  <button class="dialog-close" aria-label="Foto schließen" autofocus>✕</button>
  <div class="dialog-layout"><div class="dialog-photo"><img alt="" /><button class="previous" aria-label="Vorheriger Beitrag">←</button><button class="next" aria-label="Nächster Beitrag">→</button></div><div class="dialog-copy"><p class="eyebrow">@minorkings / Instagram</p><h3 id="post-title">Hinter den Kulissen</h3><p class="dialog-caption"></p><a class="button original-post" target="_blank" rel="noopener noreferrer">Auf Instagram öffnen ↗</a><p class="media-note">Reels, weitere Bilder und Kommentare findet ihr im Originalbeitrag.</p><span class="dialog-count" aria-live="polite"></span></div></div>
</dialog>
<script>
 const dialog = document.querySelector<HTMLDialogElement>('.instagram-dialog');
 const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.instagram-open'));
 let current = 0;
 let opener: HTMLAnchorElement | undefined;
 function show(index: number) {
  if (!dialog || !links.length) return;
  current = (index + links.length) % links.length;
  const link = links[current];
  const image = link.querySelector('img')!;
  const target = dialog.querySelector<HTMLImageElement>('img')!;
  target.src = image.src; target.alt = image.alt;
  const caption = link.closest('article')?.querySelector('template')?.content.textContent || '';
  dialog.querySelector('.dialog-caption')!.textContent = caption;
  dialog.querySelector<HTMLAnchorElement>('.original-post')!.href = link.href;
  dialog.querySelector('.dialog-count')!.textContent = `${current+1} / ${links.length}`;
 }
 links.forEach((link, index) => link.addEventListener('click',event => {
  if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
  event.preventDefault(); opener=link; show(index); dialog.showModal(); document.body.classList.add('dialog-is-open');
 }));
 dialog?.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
 dialog?.querySelector('.previous')?.addEventListener('click',()=>show(current-1));
 dialog?.querySelector('.next')?.addEventListener('click',()=>show(current+1));
 dialog?.addEventListener('keydown',event=>{if(event.key==='ArrowLeft')show(current-1);if(event.key==='ArrowRight')show(current+1);});
 dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
 dialog?.addEventListener('close',()=>{document.body.classList.remove('dialog-is-open');opener?.focus();});
</script>
