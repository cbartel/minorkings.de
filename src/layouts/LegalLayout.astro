---
import BaseLayout from './BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${title} | minor kings`} description={`${title} der minor kings Bandwebsite.`}>
  <header class="header container legal-header">
    <a class="brand-home" href={base} aria-label="minor kings Startseite"><BrandLogo class="header-logo" decorative /></a>
    <a class="text-link" href={base}>Zurück zur Band</a>
  </header>
  <main id="inhalt" class="container legal-page">
    <h1>{title}</h1>
    <div class="legal-copy"><slot /></div>
  </main>
  <SiteFooter />
</BaseLayout>
