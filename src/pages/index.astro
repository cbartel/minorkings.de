---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrandLogo from '../components/BrandLogo.astro';
import VideoCard from '../components/VideoCard.astro';
import { band } from '../data/band';
import InstagramFeed from '../components/InstagramFeed.astro';
const asset = (name: string) => `${import.meta.env.BASE_URL}media/${name}.webp`;
const members = [['Max', 'Gesang'], ['Georg', 'Lead-Gitarre'], ['Krise', 'Gitarre & Backings'], ['Josch', 'Bass'], ['Robert', 'Schlagzeug']];
---
<BaseLayout title="minor kings — Red Hot Chili Peppers Tribute aus Köln" description="Fünf Musiker. Eine gemeinsame Leidenschaft. Erlebt minor kings live — eure Red Hot Chili Peppers Tribute Band aus Köln. Videos, Band und Booking.">
  <header class="header container">
    <a class="brand-home" href={import.meta.env.BASE_URL} aria-label="minor kings Startseite"><BrandLogo class="header-logo" decorative /></a>
    <nav aria-label="Hauptnavigation"><a href="#band">Die Band</a><a href="#videos">Live & laut</a><a href="#instagram">Backstage</a></nav>
    <a class="button small" href="#booking">Booking <span aria-hidden="true">↗</span></a>
  </header>
  <main id="inhalt">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-topline"><span>Red Hot Chili Peppers Tribute</span><span>Köln, DE / Seit 2023</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title" class="hero-brand"><span class="sr-only">minor kings — Red Hot Chili Peppers Tribute</span><BrandLogo class="hero-logo" decorative /></h1>
          <p class="hero-description">Wir sind die minor kings, eine Red Hot Chili Peppers Tribute Band aus Köln. Wir spielen die Songs, die ihr kennt, und ein paar, auf die wir uns selbst besonders freuen. Am liebsten natürlich mit euch vor der Bühne.</p>
          <div class="actions"><a class="button" href="#videos">Live-Videos ansehen</a><a class="text-link" href="#booking">Kontakt &amp; Booking</a></div>
        </div>
        <figure class="hero-photo">
          <img src={asset('instagram-0')} width="1920" height="1281" alt="Die fünf Musiker von minor kings gemeinsam auf der Bühne nach einem Konzert" fetchpriority="high" />
          <figcaption><span>Fünf Musiker. Eine Leidenschaft.</span><span>Foto: @pluno</span></figcaption>
        </figure>
      </div>
      <div class="hero-bottom"><span>Funk. Rock. Pure Live-Energie.</span><a href="#band">Mehr entdecken <span aria-hidden="true">↓</span></a></div>
    </section>
    <div class="ticker" aria-hidden="true"><div>CAN’T STOP <span>✳</span> WET SAND <span>✳</span> CALIFORNICATION <span>✳</span> DARK NECESSITIES <span>✳</span> GIVE IT AWAY <span>✳</span></div></div>
    <section id="band" class="section container band-section" aria-labelledby="band-title">
      <div class="section-kicker"><span>01 / Die Band</span><span>Von Fans. Für Fans.</span></div>
      <div class="band-grid">
        <div><h2 id="band-title">Die Band</h2></div>
        <div class="band-text">
          <p>Seit 2023 spielen wir als minor kings die Musik der Red Hot Chili Peppers. Zu fünft, aus Köln und mit viel Liebe zum Detail. Wir freuen uns auf volle Clubs, kleine Bühnen und vor allem auf euch. Am schönsten ist es, wenn ihr die Songs genauso feiert wie wir.</p>
          <a class="text-link" href="#videos">Live-Videos ansehen <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <figure class="band-photo"><img src={asset('instagram-1')} width="1440" height="960" alt="minor kings beim gemeinsamen Bandshooting vor einer mit Graffiti bemalten Tribüne" loading="lazy" /><figcaption>minor kings / Köln <span>Foto: @pluno</span></figcaption></figure>
      <ul class="members">{members.map(([name, role]) => <li><strong>{name}</strong><span>{role}</span></li>)}</ul>
    </section>
    <section id="videos" class="video-section section" aria-labelledby="video-title"><div class="container">
      <div class="section-kicker"><span>02 / Live-Videos</span></div>
      <div class="section-heading"><h2 id="video-title">LIVE.<br /><em>MIT EUCH.</em></h2></div>
      <div class="video-grid">
        <VideoCard id="zDkLCXhV4-Y" title="Dark Necessities" number="01" subtitle="Red Hot Chili Peppers · Live Cover" />
        <VideoCard id="OZIB8RAD7fc" title="Wet Sand" number="02" subtitle="Red Hot Chili Peppers · Live Cover" />
        <VideoCard id="80a0mlJW0iY" title="Die RHCP Tribute Experience" number="03" subtitle="minor kings · Live" />
      </div>
      <p class="media-note">YouTube wird erst nach eurer Zustimmung beim jeweiligen Video geladen. Alternativ könnt ihr die Videos über ↗ direkt öffnen.</p>
    </div></section>
    <section id="instagram" class="section container" aria-labelledby="instagram-title">
      <div class="section-kicker"><span>03 / Abseits der Setlist</span><a href={band.instagram}>@minorkings ↗</a></div>
      <div class="section-heading"><h2 id="instagram-title">BÜHNE. BACKSTAGE.<br /><em>MITTENDRIN.</em></h2><p>Momente aus unserem Instagram.<br />Für alles Neue: folgt uns.</p></div>
      <InstagramFeed />
    </section>
    <section id="booking" class="booking-section" aria-labelledby="booking-title"><div class="container">
      <div class="section-kicker"><span>04 / Booking</span><span>Club · Festival · Euer Event</span></div>
      <div class="booking-grid"><h2 id="booking-title">EURE BÜHNE.<br />UNSER <span>SOUND.</span></h2><div><p>Ihr wollt uns bei euch spielen lassen? Schreibt uns, wann, wo und was ihr vorhabt.</p><a class="button dark" href={`mailto:${band.email}?subject=Booking-Anfrage%20minor%20kings`}>Booking anfragen <span aria-hidden="true">↗</span></a><a class="booking-email" href={`mailto:${band.email}`}>{band.email}</a></div></div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
